<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="7dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_svitlo_mark" android:tint="@color/widget_text" android:contentDescription="єСвітло" />
        <TextView android:id="@+id/widget_note" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:textColor="@color/widget_muted"
            android:includeFontPadding="false" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_warning" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_widget_warning" android:tint="@color/widget_text"
            android:contentDescription="Є попередження оператора" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp"
            android:gravity="center_horizontal" android:background="@drawable/widget_interval_surface">
            <TextView android:id="@+id/live_current_time" style="@style/WidgetIntervals"
                android:gravity="center" android:textStyle="bold" android:maxLines="2" />
            <TextView android:id="@+id/live_current_state" style="@style/WidgetDayLabel"
                android:gravity="center" android:textStyle="normal" android:textColor="@color/widget_muted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp"
            android:gravity="center_horizontal" android:background="@drawable/widget_interval_next">
            <TextView android:id="@+id/live_next_time" style="@style/WidgetIntervals"
                android:gravity="center" android:textStyle="bold" android:maxLines="2" />
            <TextView android:id="@+id/live_next_state" style="@style/WidgetDayLabel"
                android:gravity="center" android:textStyle="normal" android:textColor="@color/widget_muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
