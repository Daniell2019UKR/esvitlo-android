<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical"
    android:paddingHorizontal="8dp" android:paddingVertical="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_svitlo_mark" android:tint="@color/widget_text"
            android:contentDescription="єСвітло" />
        <TextView android:id="@+id/widget_note" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:textColor="@color/widget_muted"
            android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/widget_warning" android:layout_width="15dp" android:layout_height="15dp"
            android:src="@drawable/ic_widget_warning" android:tint="@color/widget_text"
            android:contentDescription="Є попередження оператора" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="4dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_interval_surface" android:paddingHorizontal="5dp"
            android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_today_label" style="@style/WidgetDayLabel" android:text="Сьогодні" />
            <TextView android:id="@+id/widget_today" style="@style/WidgetIntervals" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widget_interval_next" android:paddingHorizontal="5dp"
            android:layout_marginStart="4dp" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_tomorrow_label" style="@style/WidgetDayLabel" android:text="Завтра" />
            <TextView android:id="@+id/widget_tomorrow" style="@style/WidgetIntervals" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
